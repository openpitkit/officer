# Binaries and build output
/pit-officer
/bin/
*.exe
*.test
*.out

# Native runtime library dropped here for Docker Strategy B builds (see
# justfile docker-build-local recipe and Dockerfile DYLIB_PATH comment).
/libopenpit_ffi.so
/libopenpit_ffi.dylib

# Go build/test cache artifacts
*.o
*.a

# Go workspace file: opt-in local-dev override that points officer at a local
# pit binding checkout (created by `just use-local`). Never committed so the
# default build resolves the released go.openpit.dev/openpit version.
go.work
go.work.sum

# Local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Runtime state published by `serve` next to the database.
officer-runtime.json

# Frontend
/web/node_modules/
# The dist bundle is a build artifact, but a committed placeholder index.html
# (and .gitkeep) must stay tracked so the Go `go:embed web/dist` compiles on a
# fresh clone before the SPA has been built. Real build output overwrites the
# placeholder locally and is otherwise ignored.
/web/dist/*
!/web/dist/.gitkeep
!/web/dist/index.html

# Environment overrides
.env
.env.*

# Editor and OS noise
.DS_Store
*.swp
