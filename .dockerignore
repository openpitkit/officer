# Binaries and build artifacts
/pit-officer
/bin/
*.exe
*.test
*.out
*.o
*.a

# Go module cache and coverage output
coverage.out

# Local databases - never bake runtime state into the image
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Runtime state published by `serve` next to the database.
officer-runtime.json

# Frontend build dependencies - rebuilt inside the image
/web/node_modules/

# Frontend build output - rebuilt inside the image by the frontend stage
/web/dist/

# Git metadata
.git/
.gitignore

# Environment files - must not be baked into the image
.env
.env.*

# Editor and OS noise
.DS_Store
*.swp
.vscode/
.idea/

# CI and documentation (not needed in the runtime image)
.github/
docs/
justfile
Makefile
