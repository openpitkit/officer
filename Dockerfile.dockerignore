# BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile. Paths are
# relative to the officer module root build context.

# Binaries and build artifacts produced by local builds.
/pit-officer
/bin/
*.exe
*.test
*.out
*.o
*.a
coverage.out

# Local databases - never bake runtime state into the image.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Runtime state published by `serve` next to the database.
officer-runtime.json

# Rebuilt inside the image.
/web/node_modules/
/web/dist/

# Environment files - must not be baked into the image.
.env
.env.*

# CI and documentation (not needed in the runtime image).
.github/
docs/
justfile
Makefile

# Editor and OS noise.
.DS_Store
.vscode/
.idea/
**/*.swp
