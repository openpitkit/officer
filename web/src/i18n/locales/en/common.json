    "product": {
      "copy": "Pit Officer is the operator panel for risk control. It keeps accounts, balances, policies, market-data sources, audit records, REST access, MCP commands, and signing keys in one local service."
    },
    "useCases": {
      "dropCopy": {
        "title": "Drop-copy registrar",
        "copy": "Record orders, fills, account state, and audit events after execution without blocking the upstream venue."
      },
      "preTrade": {
        "title": "Pre-trade gate",
        "copy": "Approve or reject orders before they leave the system, with account balances and policy barriers applied first."
      },
      "surfaces": {
        "title": "REST and MCP",
        "copy": "Operate from the panel, REST clients, and MCP agents."
      },
      "operations": {
        "title": "Operator ledger",
        "copy": "Inspect positions, held funds, breaches, policy changes, approvals, logs, and service health."
      }
    },
    "preTrade": {
      "copy": "For allow-or-deny pre-trade control, create accounts, assign positions or cash balances, then define policy barriers. If buying-power control is not needed, accounts and balances can stay empty.",
      "copyUnnamed": "For allow-or-deny pre-trade control, assign positions or cash balances to the account, then define policy barriers. If buying-power control is not needed, the account can stay empty."
    },
    "marketData": {
      "copy": "Market orders, locked prices, cross-currency exposure, and realized PnL need a market-data source. You can connect a live provider later or install a static BYO preset now."
    },
    "optional": {
      "copy": "A pure registry or audit workflow can start without accounts, balances, or feeds. Add the controls only when the order path must be allowed or blocked by Pit."
