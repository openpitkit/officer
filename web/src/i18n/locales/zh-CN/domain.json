  "policy": {
    "rate_limit": {
      "label": "频率限制",
      "description": "统计时间窗口内的下单尝试次数。超出上限时，拒绝模式会拒绝订单，审核模式下订单将等待操作员审核。被拒绝的尝试仍计入次数，重试无法绕过限制。"
    },
    "order_size_limit": {
      "label": "订单规模限制",
      "description": "按数量和名义价值限制单笔订单的规模，防止乌龙指错误。"
    },
    "position_limit": {
      "label": "持仓限制",
      "description": "限制账户在单一资产上的最大可能多头和空头持仓，包括未成交订单。持仓等于上限时允许通过。"
    },
    "spot_funds_pnl_bounds_kill_switch": {
      "label": "已实现盈亏熔断开关",
      "description": "使用引擎在账户币种中计算的已实现盈亏（P&L），并扣除可选传入佣金。若缺少必要输入，例如用于按账户币种估值已实现 P&L 的 FX 报价，引擎会封锁处于 P&L 控制下的账户，因为无法保证限额。仅在实际需要时才要求 FX：资产已使用账户币种时不需要，未处于 P&L 控制下的账户也不需要。"
    },
    "spot_funds_unrealized_pnl_bounds_kill_switch": {
      "label": "未实现盈亏熔断开关",
      "description": "使用引擎在账户币种中按当前市场价格计算的账户持仓未实现盈亏（P&L）。P&L 超出上下限时，拒绝模式会拒绝下一笔订单并封锁账户。审核模式下，订单将等待操作员审核，账户不会因此被封锁。"
    },
    "spot_funds_total_pnl_bounds_kill_switch": {
      "label": "总盈亏熔断开关",
      "description": "使用引擎在账户币种中计算的总盈亏（P&L）：已实现 P&L 加上按当前市场价格计算的账户持仓未实现 P&L。P&L 超出上下限时，拒绝模式会拒绝下一笔订单并封锁账户。审核模式下，订单将等待操作员审核，账户不会因此被封锁。"
    },
    "spot_funds_limit_mode": {
      "label": "资金限额模式",
      "description": "设置 Officer 如何处理所有账户中资金不足的订单。未保存任何行时，模式为“检查资金”。"
    }
  },
