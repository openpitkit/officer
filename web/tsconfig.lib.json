{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "lib",
    "composite": false,
    "rootDir": "src"
  },
  "include": [
    "src/vite-env.d.ts",
    "src/index.ts",
    "src/api/types.ts",
    "src/components/data",
    "src/framework",
    "src/i18n/index.ts",
    "src/i18n/locales.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
